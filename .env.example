# Көчүрүңүз: cp .env.example .env  — анан керектүүсүн өзгөртүңүз.

# Тиркеменин порту (сервердеги)
APP_PORT=8787

# Caddy (--profile https) үчүн домен. Домен жок болсо: <сервердин-IP>.sslip.io (мис. 203.0.113.5.sslip.io)
DOMAIN=

# Caddy/nginx артында иштесе — 1
TRUST_PROXY=0

# Домен/Caddy жок, бирок телефондордун камерасы керек болсо — 1 (өзү кол койгон сертификат, браузер эскертет)
HTTPS=0
